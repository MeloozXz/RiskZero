{
  "manifest_version": 3,
  "name": "SeguranApp VPN - Navegador Seguro",
  "version": "2.0.0",
  "description": "VPN de Navegador com tunelamento proxy real, proteção de geolocalização e bypass de restrições de rede.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "tabs",
    "webRequest",
    "webRequestAuthProvider",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SeguranApp VPN",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject-geolocation.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
